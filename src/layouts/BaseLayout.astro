---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Open-source idea collision radar for developers. Paste a one-sentence pitch to check overlap across 94+ repos (AI, hardware, gamedev, devtools & indie builds), spot missing angles, or signal stealth work anonymously."
} = Astro.props;

const siteUrl = 'https://alsobuilt.pages.dev';
const ogImage = `${siteUrl}/og-card.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0d14" />
    <link rel="canonical" href={`${siteUrl}/`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${siteUrl}/`} />
    <meta property="og:site_name" content="AlsoBuilt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AlsoBuilt — See who's already building your idea" />

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-[var(--border)] bg-[var(--card)]/90 backdrop-blur sticky top-0 z-30">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-4 flex-wrap">
        <a href="/" class="flex items-center gap-2.5 no-underline">
          <img src="/logo.svg" alt="AlsoBuilt logo" width="30" height="30" />
          <div>
            <div class="text-[17px] font-bold tracking-tight leading-none">
              also<span class="font-medium text-[var(--muted)]">built</span>
            </div>
            <div class="text-[11px] text-[var(--muted)] mt-0.5">
              Parallel open-source builds &amp; idea collision radar
            </div>
          </div>
        </a>

        <div class="flex items-center gap-2">
          <a
            href="https://github.com/stephenwil/alsobuilt/tree/main/mcp"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1.5 rounded-lg bg-[var(--secondary)] border border-[var(--border)] font-mono text-[11px] text-[var(--muted)] no-underline hover:text-[var(--fg)] transition"
            title="Use AlsoBuilt directly from Claude Code, Cursor, or Codex via MCP"
          >
            MCP
          </a>
          <a
            href="/index.json"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1.5 rounded-lg bg-[var(--secondary)] border border-[var(--border)] font-mono text-[11px] text-[var(--muted)] no-underline hover:text-[var(--fg)] transition"
            title="CORS-enabled public catalog JSON feed"
          >
            index.json
          </a>
          <a
            href="https://github.com/stephenwil/alsobuilt"
            target="_blank"
            rel="noopener noreferrer"
            class="px-2.5 py-1.5 rounded-lg bg-[var(--secondary)] border border-[var(--border)] font-mono text-[11px] text-[var(--muted)] no-underline hover:text-[var(--fg)] transition"
            title="View repository & submit variants via PR or Issue"
          >
            GitHub ↗
          </a>
        </div>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-5">
      <slot />
    </main>

    <footer class="max-w-5xl mx-auto px-4 py-6 text-xs text-[var(--muted)] flex items-center justify-between flex-wrap gap-2 border-t border-[var(--border)] mt-8">
      <span>AlsoBuilt · Open-Source Build &amp; Idea Collision Radar</span>
      <span class="font-mono">Git-First Catalog · Cloudflare Pages + D1</span>
    </footer>
  </body>
</html>
