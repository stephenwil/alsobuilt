---
import '../styles/global.css';

interface Props {
  title: string;
  activeNav: 'hub' | 'vault';
}

const { title, activeNav } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-[var(--border)] bg-[var(--card)]/90 backdrop-blur sticky top-0 z-30">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-4 flex-wrap">
        <a href="/" class="flex items-center gap-2.5 no-underline">
          <img src="/logo.svg" alt="AlsoBuilt logo" width="30" height="30" />
          <div>
            <div class="text-[17px] font-bold tracking-tight leading-none">
              also<span class="font-medium text-[var(--muted)]">built</span>
            </div>
            <div class="text-[11px] text-[var(--muted)] mt-0.5">
              Parallel AI builds &amp; idea collision radar
            </div>
          </div>
        </a>

        <nav class="flex items-center gap-1.5 bg-[var(--secondary)] border border-[var(--border)] p-1 rounded-lg">
          <a
            href="/"
            class:list={[
              'px-3 py-1.5 rounded-md text-xs font-medium no-underline transition',
              activeNav === 'hub'
                ? 'bg-[var(--card)] text-[var(--fg)] shadow-sm'
                : 'text-[var(--muted)] hover:text-[var(--fg)]'
            ]}
          >
            Open Hub
          </a>
          <a
            href="/vault"
            class:list={[
              'px-3 py-1.5 rounded-md text-xs font-medium no-underline transition inline-flex items-center gap-1.5',
              activeNav === 'vault'
                ? 'bg-[var(--card)] text-[var(--fg)] shadow-sm'
                : 'text-[var(--muted)] hover:text-[var(--fg)]'
            ]}
          >
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--purple)]"></span>
            Personal Vault
          </a>
        </nav>
      </div>
    </header>

    <main class="max-w-5xl mx-auto px-4 py-5">
      <slot />
    </main>

    <footer class="max-w-5xl mx-auto px-4 py-6 text-xs text-[var(--muted)] flex items-center justify-between flex-wrap gap-2 border-t border-[var(--border)] mt-8">
      <span>AlsoBuilt · Dual-D1 Open Hub + Private Vault</span>
      <span class="font-mono">Cloudflare Pages + D1 SQLite</span>
    </footer>
  </body>
</html>
